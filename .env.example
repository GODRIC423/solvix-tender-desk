# Copy to .env and fill in. Never commit the real .env.
# The anon key is safe to ship in a browser bundle — Row Level Security is what
# actually protects the data, not the key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the standalone connector posts extracted tenders.
VITE_INGEST_ENDPOINT=https://your-project.supabase.co/functions/v1/ingest-load
